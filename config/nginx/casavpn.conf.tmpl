# /etc/nginx/sites-available/casavpn: the web front end on port @WEB_PORT@.
# CasaVPN template: install.sh fills in the placeholders. Needs conf.d/00-casavpn.conf.
#
# What is public here: only /sub/ (client subscriptions). The panel is behind
# the admin-only snippet (LAN, Tailscale, loopback) and its path is secret.
# Everything else is a 404 for a scanner.

# A request without a matching server name (an IP scan, a wrong Host) gets no
# TLS handshake at all, so scanning the bare IP reveals nothing about what runs
# here. The certificate is issued for @DOMAIN@, so open the panel by that name
# (a hosts entry or split DNS pointing at this host), never by the bare LAN IP.
#
# HTTP/2: nginx 1.25.1+ takes "http2 on;" in the server block; older versions
# (Debian 12 ships 1.22) need "http2" in the listen line. install.sh picks the
# right form for the installed nginx.
server {
    listen @WEB_PORT@ ssl default_server@HTTP2_LISTEN@;
    listen [::]:@WEB_PORT@ ssl default_server@HTTP2_LISTEN@;
    ssl_reject_handshake on;
}

server {
    listen @WEB_PORT@ ssl@HTTP2_LISTEN@;
    listen [::]:@WEB_PORT@ ssl@HTTP2_LISTEN@;
    @HTTP2_ON@
    server_name @DOMAIN@;

    ssl_certificate     /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options           "DENY"        always;
    add_header X-Content-Type-Options    "nosniff"     always;
    add_header Referrer-Policy           "no-referrer" always;

    # Keep the panel out of search engines even if the path ever leaks.
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Subscription endpoint used by Shadowrocket, v2rayN, Streisand and friends.
    location /sub/ {
        limit_req zone=casavpn_sub burst=10 nodelay;
        proxy_pass http://127.0.0.1:@SUB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  @WEB_PORT@;
        proxy_set_header X-Forwarded-Ssl   on;
    }

    # The panel, under its secret base path. LAN / Tailscale / loopback only.
    location /@PANEL_BASE_PATH@/ {
        include /etc/nginx/snippets/casavpn-admin-only.conf;
        proxy_pass http://127.0.0.1:@PANEL_PORT@/@PANEL_BASE_PATH@/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  @WEB_PORT@;
        proxy_set_header X-Forwarded-Ssl   on;
        proxy_redirect off;
        proxy_read_timeout 300s;
    }

    # Everything else is a scanner. Give it nothing.
    location / {
        return 404;
    }
}
