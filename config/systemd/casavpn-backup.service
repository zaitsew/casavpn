[Unit]
Description=Encrypted backup of the VPN host state (x-ui DB, nginx, TLS, firewall)
Documentation=file:///usr/local/share/doc/casavpn/BACKUP.md

[Service]
Type=oneshot
ExecStartPre=+/usr/bin/install -d -m 0700 /var/backups/casavpn
ExecStart=/usr/local/bin/casavpn-backup
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle

# Root is needed to read the Reality key and the TLS keys; nothing else is.
User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
NoNewPrivileges=true

# Read-only view of the system, with exactly two writable spots:
#   /var/backups/casavpn  where the encrypted archives land
#   /etc/x-ui             sqlite must be able to touch x-ui.db-shm to read a WAL db
ProtectSystem=strict
ReadWritePaths=-/var/backups/casavpn /etc/x-ui
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
IPAddressDeny=any
UMask=0077
