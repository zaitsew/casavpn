# The 3x-ui release this version of CasaVPN installs and was written against.
# install.sh and upgrade.sh read this file (parsed, never sourced) and refuse a
# tarball whose SHA-256 does not match. To move to a newer release, change both
# lines in one commit after reading the release notes and testing an upgrade
# (docs/UPGRADING.md); the hashes come from the release page's .sha256 assets.
#
# v3.10.2 is the newest release at the time of writing; the maintainer's own
# deployment ran 3.6.0 -> 3.10.2 only once, so treat the first install as a test.
XUI_VERSION=v3.10.2
XUI_SHA256_AMD64=bfda7921984e7a72555c38d4e861c7a8b67b3686b658608937de99682f1452d0
XUI_SHA256_ARM64=a867c65ce52ad49f6504dd4c9c395337dc92ba57ae478da4f1b7ddb624014ed5
XUI_REPO=MHSanaei/3x-ui
