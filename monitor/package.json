{
  "name": "casavpn-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "External uptime monitor and alert relay for vpn.example.com:443 (Cloudflare Worker, cron every 5 minutes, push alerts through APNs)",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.0"
  }
}
