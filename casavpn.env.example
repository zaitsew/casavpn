# CasaVPN settings: one file for every script.
#
#   sudo install -d -m 0755 /etc/casavpn
#   sudo install -m 0600 -o root -g root casavpn.env.example /etc/casavpn/casavpn.env
#   sudo $EDITOR /etc/casavpn/casavpn.env
#
# Plain KEY=VALUE lines. The scripts PARSE this file, they never `source` it, so
# no value is ever executed. Quotes are optional. Never commit the real file
# (it is git-ignored) and never paste it into a chat or an issue: it holds an
# API token.

# --- required ---------------------------------------------------------------

# The hostname your clients connect to. A name in a domain you control.
CASAVPN_DOMAIN=vpn.example.com

# The home network, as CIDR. SSH and the panel are reachable from here only.
# Find it with: ip -4 route | grep 'dev eth0 proto kernel'
CASAVPN_LAN_CIDR=192.168.0.0/24

# The router's address on the LAN (optional). The panel's nginx rules DENY it
# before allowing the LAN: routers that hairpin a VPN user's request for the
# public hostname back to the Pi rewrite its source to this address, which would
# otherwise pass the LAN rule. Empty = install.sh detects it from the default
# route; "none" = do not add the rule (docs/HARDENING.md, "Hairpin NAT").
CASAVPN_LAN_GATEWAY=
# Addresses or CIDRs fail2ban must never ban, separated by spaces or commas
# (optional). Only loopback is exempt by default, so a device on the LAN that
# guesses SSH passwords gets banned. Add your own laptop's fixed address here.
CASAVPN_FAIL2BAN_IGNOREIP=

# The user you log in as over SSH (it needs an authorized key and sudo).
CASAVPN_ADMIN_USER=pi

# --- ports (defaults are fine; the router forwards ONLY the first two) ---------

# Reality / VLESS. 443 looks like ordinary HTTPS to a firewall that checks ports.
CASAVPN_VPN_PORT=443
# nginx: /sub/ client subscriptions (public) and the panel (LAN/Tailscale only).
CASAVPN_WEB_PORT=8443
# Your sshd port (informational for the firewall and fail2ban; install.sh does
# not change sshd's own Port).
CASAVPN_SSH_PORT=22
# 3x-ui listens on these two ports on 127.0.0.1 only; nginx is the front door.
CASAVPN_PANEL_PORT=2053
CASAVPN_SUB_PORT=2096

# --- Reality ------------------------------------------------------------------

# REQUIRED, NO DEFAULT: the real HTTPS site Reality imitates for anyone who is
# not a client, as a bare hostname (e.g. www.example.net). Every server that
# shares a popular default is easier to fingerprint, and Xray itself warns about
# the well-known choices. Choose one that serves TLS 1.3 + HTTP/2 on 443
# directly, is near the Pi, and is not one of the big defaults. How to check a
# candidate: docs/REALITY-TARGET.md. The healthcheck uses it to confirm the
# camouflage works.
CASAVPN_REALITY_TARGET=
# Xray refuses Reality clients older than this. Re-asserted after every upgrade.
CASAVPN_MIN_CLIENT_VER=1.8.0
# Which Xray core runs. "pinned" (default): install.sh and casavpn-upgrade put the
# core named in config/xray-core.env (SHA-256 checked) over the one 3x-ui bundles,
# because Xray 26.10.10, bundled with 3x-ui 3.10.2, refuses Shadowrocket at Reality.
# "bundled": keep whatever core the 3x-ui release ships (the next casavpn-upgrade
# restores it from xray-linux-<arch>.bundled). After ANY core change, test
# Shadowrocket on mobile data (docs/UPGRADING.md).
CASAVPN_XRAY_CORE=pinned

# --- dynamic IP and certificates (Cloudflare) -------------------------------------

# Only "cloudflare" exists today (see docs/DYNAMIC-IP.md for adding another).
CASAVPN_DDNS_PROVIDER=cloudflare
# Token scoped Zone > DNS > Edit for THIS zone only. Create it at
# dash.cloudflare.com -> My Profile -> API Tokens. Leave empty to skip DDNS and
# certificates (the VPN itself works without them if your IP never changes).
CF_API_TOKEN=
# Zone ID: the zone's Overview page, right-hand column.
CF_ZONE_ID=
# E-mail Let's Encrypt may contact about the certificate. Optional.
CASAVPN_ACME_EMAIL=
# Set to 1 to get test certificates while you are experimenting (no rate limits).
CASAVPN_ACME_STAGING=0

# --- alerts -------------------------------------------------------------------------

# Optional push alerts through ntfy.sh (no account). The topic name is the only
# secret, so make it unguessable: https://ntfy.sh/casavpn-$(openssl rand -hex 8)
# Subscribe to the same topic in the ntfy app. Empty = log only.
NTFY_URL=

# Optional alert relay for the CasaVPN iPhone app (docs/APP.md): the monitor Worker
# in monitor/. casavpn-ddns and casavpn-alerts post their events there, and it
# pushes them to the phone. The token is the Worker's HOST_TOKEN secret, not the
# app's. Set both or neither. Leave empty to skip the relay.
#CASAVPN_RELAY_URL=https://casavpn-monitor.example.workers.dev
#CASAVPN_RELAY_TOKEN=

# --- operating-system upgrades ------------------------------------------------------

# casavpn-os-upgrade upgrades every Debian package on the first Sunday of the month
# at 04:30, reboots, and checks the VPN came back (docs/UPGRADING.md). off = you
# upgrade by hand. Daily security upgrades (unattended-upgrades) run either way.
CASAVPN_OS_UPGRADE=monthly
# Optional: never reboot (auto = reboot after an upgrade), more units the
# post-check expects back, the DDNS command it runs with --check (none = skip).
#CASAVPN_OS_UPGRADE_REBOOT=auto
#CASAVPN_OS_UPGRADE_UNITS=
#CASAVPN_OS_UPGRADE_DDNS=/usr/local/bin/casavpn-ddns

# --- backups ------------------------------------------------------------------------

# age PUBLIC key (age1...) the backups are encrypted to. Make the pair on your
# laptop, not on the Pi:  age-keygen -o ~/.config/casavpn/age-identity.txt
# and keep the identity file safe: without it a backup cannot be opened.
AGE_RECIPIENT=
# Archives kept on the host (default 14).
CASAVPN_BACKUP_KEEP=14
# Optional group allowed to read the encrypted archives (so a non-root user can
# pull them). Empty = root only.
CASAVPN_BACKUP_GROUP=

# Used by scripts that run on your laptop (healthcheck, pull-backups,
# gen-client-links): how to reach the host.
CASAVPN_SSH_TARGET=
