#!/usr/bin/env bash
#
# casavpn-ddns — keep the VPN hostname pointed at this host's current public IP,
# and say so loudly when it cannot.
#
# Every run (the systemd timer fires once a minute):
#   1. discovers the public IPv4 from four independent echo services and needs
#      two to agree (a tie or a lone answer means "do nothing, exit 1");
#   2. refuses non-public answers (RFC1918, CGNAT 100.64/10, loopback, ...);
#   3. reads the record back from the DNS provider (never trusts a local cache);
#   4. if content != IP, proxied != false, ttl != 60 or type != A, rewrites it,
#      reads it back again and only then records success.
#
# Configuration lives in /etc/casavpn/casavpn.env (mode 0600, root); see
# casavpn.env.example. The file is parsed, never executed. Requires: bash,
# curl, jq (and flock on Linux).
#
#   CASAVPN_DOMAIN          the hostname to keep current (the A record name)
#   CASAVPN_DDNS_PROVIDER   cloudflare (default). See "provider contract" below.
#   CF_API_TOKEN, CF_ZONE_ID   Cloudflare credentials (provider cloudflare)
#   NTFY_URL                optional push alerts
#
# Usage: casavpn-ddns [--check] [--dry-run] [--force]
#   --check    exit 0 if the DNS record == public IP, else 1. Writes nothing.
#   --dry-run  do everything except write: no provider change, no state
#              file, no alert. Logs what it would do.
#   --force    rewrite the record even when it already looks right (a real
#              write + read-back round trip, e.g. to prove the token works).
#
# Exit codes: 0 ok (or another run holds the lock), 1 failure, 2 usage.
#
# Public-IP echo services cannot detect CGNAT: behind carrier-grade NAT they
# report the carrier's shared address, which is a *valid public* IP that does
# not reach this host. The only honest test is from outside: connect to
# <record>:<VPN port> from another network (phone on mobile data). --check
# prints that hint.
#
# Provider contract (add a provider by defining these five functions, named
# provider_<name>_<verb>, then listing the name in KNOWN_PROVIDERS):
#   validate                 die if the provider's settings are missing
#   get                      set RECORDS to a JSON array of the A records for
#                            the name: [{"id","content","ttl","proxied"}, ...]
#   update <id> <ip>         create (empty id) or overwrite the record
#   record_ok <ip>           true when RECORDS is exactly the desired state
#   describe_drift <ip>      one line saying what differs (for logs and alerts)

set -u -o pipefail

ENV_FILE="${CASAVPN_ENV_FILE:-/etc/casavpn/casavpn.env}"
STATE_DIR="${CASAVPN_DDNS_STATE_DIR:-/var/lib/casavpn-ddns}"
CF_API="${CASAVPN_DDNS_CF_API:-https://api.cloudflare.com/client/v4}"
KNOWN_PROVIDERS="cloudflare"
DESIRED_TTL=60
ALERT_INTERVAL=3600   # at most one identical alert per hour
FAIL_ALERT_AFTER=3    # consecutive failed runs before the "failing" push

# Independent public-IP sources: "url|format".
IP_SOURCES=(
  "https://api.ipify.org|plain"
  "https://ipv4.icanhazip.com|plain"
  "https://checkip.amazonaws.com|plain"
  "https://1.1.1.1/cdn-cgi/trace|trace"
)

FORCE=0
DRY_RUN=0
CHECK=0
WRITES=1        # 0 in --dry-run / --check: nothing may touch disk or the network
LOCK_HELD=0
LOCKDIR=""
LAST_ERROR=""
PUBLIC_IP=""
RECORDS="[]"

CF_API_TOKEN="${CF_API_TOKEN:-}"
CF_ZONE_ID="${CF_ZONE_ID:-}"
CASAVPN_DOMAIN="${CASAVPN_DOMAIN:-}"
CASAVPN_DDNS_PROVIDER="${CASAVPN_DDNS_PROVIDER:-cloudflare}"
CASAVPN_VPN_PORT="${CASAVPN_VPN_PORT:-443}"
NTFY_URL="${NTFY_URL:-}"
CASAVPN_DDNS_EXPECT_IFACE="${CASAVPN_DDNS_EXPECT_IFACE:-}"
CASAVPN_DDNS_EXPECT_GATEWAY="${CASAVPN_DDNS_EXPECT_GATEWAY:-}"

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { printf '%s %s\n' "$(ts)" "$*"; }
err() { printf '%s ERROR: %s\n' "$(ts)" "$*" >&2; }
die() { LAST_ERROR="$*"; err "$*"; exit 1; }

usage() {
  awk '/^set /{exit} NR>2{sub(/^# ?/,""); print}' "$0"
}

# --- IPv4 validation ----------------------------------------------------------

# valid_ipv4 <string>: four decimal octets, each 0-255, no leading zeros.
valid_ipv4() {
  local re='^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})$'
  local i
  [[ "$1" =~ $re ]] || return 1
  for i in 1 2 3 4; do
    (( BASH_REMATCH[i] <= 255 )) || return 1
  done
  return 0
}

# non_public_reason <ipv4>: prints why the address is not publicly routable and
# returns 0; returns 1 (printing nothing) for an address that is fine to publish.
non_public_reason() {
  local a b c
  IFS=. read -r a b c _ <<<"$1"
  if   (( a == 0 ));                         then echo "0.0.0.0/8 (this network)"
  elif (( a == 10 ));                        then echo "10.0.0.0/8 (RFC1918 private)"
  elif (( a == 100 && b >= 64 && b <= 127 )); then echo "100.64.0.0/10 (CGNAT shared address space)"
  elif (( a == 127 ));                       then echo "127.0.0.0/8 (loopback)"
  elif (( a == 169 && b == 254 ));           then echo "169.254.0.0/16 (link-local)"
  elif (( a == 172 && b >= 16 && b <= 31 )); then echo "172.16.0.0/12 (RFC1918 private)"
  elif (( a == 192 && b == 168 ));           then echo "192.168.0.0/16 (RFC1918 private)"
  elif (( a == 192 && b == 0 && c == 0 ));   then echo "192.0.0.0/24 (IETF protocol assignments)"
  elif (( a == 192 && b == 0 && c == 2 ));   then echo "192.0.2.0/24 (documentation)"
  elif (( a == 198 && (b == 18 || b == 19) )); then echo "198.18.0.0/15 (benchmarking)"
  elif (( a == 198 && b == 51 && c == 100 )); then echo "198.51.100.0/24 (documentation)"
  elif (( a == 203 && b == 0 && c == 113 )); then echo "203.0.113.0/24 (documentation)"
  elif (( a >= 224 ));                       then echo "224.0.0.0/3 (multicast/reserved)"
  else return 1
  fi
}

# --- state, lock, alerts --------------------------------------------------------

read_state() { cat "$STATE_DIR/$1" 2>/dev/null || true; }

# write_state <name> <value>: atomic (temp file + mv); a no-op in read-only modes.
write_state() {
  [[ "$WRITES" -eq 1 ]] || return 0
  local tmp
  tmp=$(mktemp "$STATE_DIR/.tmp.XXXXXX") || return 1
  if printf '%s\n' "$2" >"$tmp" && mv -f "$tmp" "$STATE_DIR/$1"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# write_state_if_changed: skips the write when the value is already stored, so a
# healthy minute-by-minute loop does not wear the Pi's SD card.
write_state_if_changed() {
  [[ "$(read_state "$1")" == "$2" ]] || write_state "$1" "$2"
}

acquire_lock() {
  mkdir -p "$STATE_DIR" || die "cannot create state dir $STATE_DIR"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$STATE_DIR/lock" || die "cannot open lock file in $STATE_DIR"
    if ! flock -n 9; then
      log "another run holds the lock; skipping"
      exit 0
    fi
  else
    # Portable fallback for machines without flock (macOS dev boxes). The Pi
    # always has flock (util-linux), so production uses the branch above.
    local pid
    LOCKDIR="$STATE_DIR/lock.d"
    if ! mkdir "$LOCKDIR" 2>/dev/null; then
      pid=$(cat "$LOCKDIR/pid" 2>/dev/null || true)
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        LOCKDIR=""
        log "another run holds the lock; skipping"
        exit 0
      fi
      rm -rf "$LOCKDIR"
      mkdir "$LOCKDIR" || die "cannot take lock $LOCKDIR"
    fi
    printf '%s' "$$" >"$LOCKDIR/pid"
  fi
  LOCK_HELD=1
}

# alert <key> <priority> <title> <message>
# Always logged. Pushed to NTFY_URL when set, at most once per ALERT_INTERVAL
# per key. A failed push never fails the run.
alert() {
  local key="$1" prio="$2" title="$3" msg="$4" safe now last
  log "ALERT[$key] $title: $msg"
  [[ -n "$NTFY_URL" ]] || return 0
  if [[ "$WRITES" -ne 1 ]]; then
    log "(read-only mode: alert not sent)"
    return 0
  fi
  safe=$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-100)
  now=$(date +%s)
  last=$(read_state "alert-$safe")
  if [[ "$last" =~ ^[0-9]+$ ]] && (( now - last < ALERT_INTERVAL )); then
    log "alert '$key' suppressed (already sent within the hour)"
    return 0
  fi
  # -f: an HTTP 4xx/5xx (429, 503...) is a failed delivery, so the rate-limit
  # state is only written on 2xx and the next run retries.
  if curl -fsS --max-time 10 --connect-timeout 5 \
       -H "Title: $title" -H "Priority: $prio" -H "Tags: satellite" \
       -d "$msg" "$NTFY_URL" >/dev/null; then
    write_state "alert-$safe" "$now"
  else
    err "could not deliver the ntfy alert '$key'"
  fi
}

on_exit() {
  local rc=$? count
  trap - EXIT
  [[ -z "$LOCKDIR" ]] || rm -rf "$LOCKDIR"
  if [[ "$rc" -ne 0 && "$LOCK_HELD" -eq 1 && "$WRITES" -eq 1 ]]; then
    count=$(read_state fail-count)
    [[ "$count" =~ ^[0-9]+$ ]] || count=0
    count=$((count + 1))
    write_state fail-count "$count"
    if (( count >= FAIL_ALERT_AFTER )); then
      alert "failing" high "casavpn-ddns failing" \
        "casavpn-ddns failed $count runs in a row. Last error: ${LAST_ERROR:-unknown}"
    fi
  fi
  exit "$rc"
}

# --- environment file -----------------------------------------------------------

# Parsed, never sourced: the file is data, not code. Known keys only; the file
# is shared with install.sh and the backup job, so other keys are ignored
# silently (a once-a-minute job must not log noise).
load_env_file() {
  [[ -r "$ENV_FILE" ]] || die "cannot read $ENV_FILE"
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue ;; esac
    [[ "$line" == *=* ]] || continue
    line="${line#export }"
    key="${line%%=*}"
    val="${line#*=}"
    key="${key//[[:space:]]/}"
    case "$val" in
      \"*\") val="${val#\"}"; val="${val%\"}" ;;
      \'*\') val="${val#\'}"; val="${val%\'}" ;;
    esac
    case "$key" in
      CF_API_TOKEN|CF_ZONE_ID|CASAVPN_DOMAIN|CASAVPN_DDNS_PROVIDER|CASAVPN_VPN_PORT|NTFY_URL|\
      CASAVPN_DDNS_EXPECT_IFACE|CASAVPN_DDNS_EXPECT_GATEWAY)
        printf -v "$key" '%s' "$val" ;;
      *) ;;   # the env file is shared; keys for other tools are not ours to judge
    esac
  done <"$ENV_FILE"
}

# --- providers ---------------------------------------------------------------------
# Everything provider-specific lives in provider_<name>_* functions (see the
# "provider contract" in the header). The rest of the script only calls
# provider_call <verb>, so adding DuckDNS, Namecheap, a self-hosted nsupdate...
# means writing five small functions and adding the name to KNOWN_PROVIDERS.

provider_call() {
  local verb="$1"; shift
  "provider_${CASAVPN_DDNS_PROVIDER}_${verb}" "$@"
}

# --- provider: Cloudflare -----------------------------------------------------------

# cf_api <method> <path> [body]: prints the response body. Fails on transport
# errors, non-JSON, or "success": false — an HTTP 200 alone proves nothing.
cf_api() {
  local method="$1" path="$2" body="${3:-}" out
  local args=(-sS -X "$method" -H "Content-Type: application/json"
              --max-time 20 --connect-timeout 5 -K -)
  # Only GET is retried by curl; a retried POST could create a duplicate.
  [[ "$method" == "GET" ]] && args+=(--retry 2 --retry-delay 2 --retry-max-time 40)
  [[ -n "$body" ]] && args+=(--data "$body")
  # The token goes in via curl's config on stdin, not argv (visible in ps).
  if ! out=$(printf 'header = "Authorization: Bearer %s"\n' "$CF_API_TOKEN" \
               | curl "${args[@]}" "${CF_API}${path}"); then
    err "Cloudflare API $method $path: request failed"
    return 1
  fi
  if ! jq -e '.success == true' <<<"$out" >/dev/null 2>&1; then
    err "Cloudflare API $method $path: success != true: $(jq -c '.errors' <<<"$out" 2>/dev/null | head -c 300)"
    return 1
  fi
  printf '%s' "$out"
}

provider_cloudflare_validate() {
  [[ -n "$CF_API_TOKEN" ]] || die "CF_API_TOKEN not set in $ENV_FILE"
  [[ -n "$CF_ZONE_ID" ]]   || die "CF_ZONE_ID not set in $ENV_FILE"
}

provider_cloudflare_get() {
  local out
  out=$(cf_api GET "/zones/${CF_ZONE_ID}/dns_records?type=A&name=${CASAVPN_DOMAIN}") || return 1
  RECORDS=$(jq -c '[.result[]? | select(.type == "A")]' <<<"$out") || return 1
}

provider_cloudflare_update() {
  local id="$1" ip="$2" payload
  payload=$(jq -nc --arg n "$CASAVPN_DOMAIN" --arg c "$ip" --argjson t "$DESIRED_TTL" \
    '{type: "A", name: $n, content: $c, ttl: $t, proxied: false}')
  if [[ -n "$id" ]]; then
    cf_api PUT "/zones/${CF_ZONE_ID}/dns_records/${id}" "$payload" >/dev/null
  else
    cf_api POST "/zones/${CF_ZONE_ID}/dns_records" "$payload" >/dev/null
  fi
}

# exactly one A record, content == ip, grey cloud (proxied=false), ttl 60.
provider_cloudflare_record_ok() {
  jq -e --arg ip "$1" --argjson ttl "$DESIRED_TTL" \
    'length == 1 and .[0].type == "A" and .[0].content == $ip
     and .[0].proxied == false and .[0].ttl == $ttl' <<<"$RECORDS" >/dev/null 2>&1
}

provider_cloudflare_describe_drift() {
  jq -r --arg ip "$1" --argjson ttl "$DESIRED_TTL" '
    [ (if .[0].content != $ip then "content \(.[0].content)->\($ip)" else empty end),
      (if .[0].proxied != false then "proxied \(.[0].proxied)->false" else empty end),
      (if .[0].ttl != $ttl then "ttl \(.[0].ttl)->\($ttl)" else empty end) ]
    | join(", ")' <<<"$RECORDS"
}

# record_matches <ip>: provider-neutral wrapper used by the main flow.
record_matches() { provider_call record_ok "$1"; }

# --- public IP discovery ------------------------------------------------------------

discover_public_ip() {
  local entry url fmt raw ip good="" tally top_n second_n
  for entry in "${IP_SOURCES[@]}"; do
    url="${entry%%|*}"
    fmt="${entry##*|}"
    if ! raw=$(curl -4 -sS --max-time 8 --connect-timeout 4 --retry 1 --retry-delay 1 "$url" 2>/dev/null); then
      log "ip source $url: no answer"
      continue
    fi
    [[ "$fmt" == "trace" ]] && raw=$(sed -n 's/^ip=//p' <<<"$raw" | head -n 1)
    ip=$(printf '%s' "$raw" | tr -d '[:space:]')
    if valid_ipv4 "$ip"; then
      good="${good}${ip}"$'\n'
    else
      log "ip source $url: ignoring invalid answer '$(printf '%s' "$raw" | head -c 40)'"
    fi
  done
  [[ -n "$good" ]] || die "no public-IP source gave a valid IPv4 address"

  tally=$(printf '%s' "$good" | sort | uniq -c | sort -rn)
  top_n=$(awk 'NR == 1 {print $1 + 0}' <<<"$tally")
  second_n=$(awk 'NR == 2 {print $1 + 0}' <<<"$tally")
  second_n="${second_n:-0}"
  if (( top_n < 2 || top_n <= second_n )); then
    die "public-IP sources do not agree (need two matching answers, no tie): $(tr -s ' \n' ' ' <<<"$tally")"
  fi
  PUBLIC_IP=$(awk 'NR == 1 {print $2}' <<<"$tally")
  log "public IP $PUBLIC_IP (confirmed by $top_n sources)"
}

check_public_ip() {
  local why
  if why=$(non_public_reason "$PUBLIC_IP"); then
    alert "nonpublic-$PUBLIC_IP" high "CasaVPN: IP not public" \
      "Discovered address $PUBLIC_IP is in $why. Not publishing it. If this is CGNAT, ask your ISP for a public IP, or see docs/DYNAMIC-IP.md (CGNAT)."
    die "refusing to publish $PUBLIC_IP: $why"
  fi
}

# --- egress guard -------------------------------------------------------------------

# Guards against publishing a tunnel's address if outbound traffic ever leaves
# through a VPN/proxy. Default is to log the route and refuse only tun/wg-style
# devices; CASAVPN_DDNS_EXPECT_IFACE / CASAVPN_DDNS_EXPECT_GATEWAY tighten it.
# CASAVPN_DDNS_EGRESS_IFACE overrides route detection (used by the tests).
check_egress() {
  local dev="" via=""
  if [[ -n "${CASAVPN_DDNS_EGRESS_IFACE:-}" ]]; then
    dev="$CASAVPN_DDNS_EGRESS_IFACE"
    via="${CASAVPN_DDNS_EGRESS_GATEWAY:-}"
  elif command -v ip >/dev/null 2>&1; then
    read -r dev via <<<"$(ip -4 route get 1.1.1.1 2>/dev/null | head -n 1 \
      | awk '{for (i = 1; i < NF; i++) {if ($i == "dev") d = $(i + 1); if ($i == "via") v = $(i + 1)}} END {print d, v}')"
  fi
  if [[ -z "$dev" ]]; then
    log "egress route: could not be inspected"
    return 0
  fi
  log "egress route: dev=$dev via=${via:-direct}"
  case "$dev" in
    tun*|tap*|wg*|utun*|ppp*|tailscale*)
      die "outbound traffic leaves via $dev (a tunnel); refusing to publish its address" ;;
  esac
  if [[ -n "$CASAVPN_DDNS_EXPECT_IFACE" && "$dev" != "$CASAVPN_DDNS_EXPECT_IFACE" ]]; then
    die "egress interface is $dev, expected $CASAVPN_DDNS_EXPECT_IFACE"
  fi
  if [[ -n "$CASAVPN_DDNS_EXPECT_GATEWAY" && "$via" != "$CASAVPN_DDNS_EXPECT_GATEWAY" ]]; then
    die "egress gateway is '${via:-none}', expected $CASAVPN_DDNS_EXPECT_GATEWAY"
  fi
}

# --- main -----------------------------------------------------------------------------

describe_drift() { provider_call describe_drift "$PUBLIC_IP"; }

main() {
  local arg tool count old_ip rid drift rc
  for arg in "$@"; do
    case "$arg" in
      --force)   FORCE=1 ;;
      --dry-run) DRY_RUN=1 ;;
      --check)   CHECK=1 ;;
      -h|--help) usage; exit 0 ;;
      *) echo "unknown argument: $arg" >&2; usage >&2; exit 2 ;;
    esac
  done
  if [[ "$CHECK" -eq 1 && ( "$FORCE" -eq 1 || "$DRY_RUN" -eq 1 ) ]]; then
    echo "--check cannot be combined with --force or --dry-run" >&2
    exit 2
  fi
  [[ "$DRY_RUN" -eq 1 || "$CHECK" -eq 1 ]] && WRITES=0

  trap on_exit EXIT
  for tool in curl jq awk sort; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed (apt install curl jq)"
  done

  [[ "$WRITES" -eq 1 ]] && acquire_lock
  load_env_file
  [[ -n "$CASAVPN_DOMAIN" ]] || die "CASAVPN_DOMAIN not set in $ENV_FILE"
  case " $KNOWN_PROVIDERS " in
    *" $CASAVPN_DDNS_PROVIDER "*) ;;
    *) die "unknown CASAVPN_DDNS_PROVIDER '$CASAVPN_DDNS_PROVIDER' (known: $KNOWN_PROVIDERS)" ;;
  esac
  provider_call validate

  discover_public_ip
  check_public_ip
  check_egress

  provider_call get || die "could not read ${CASAVPN_DOMAIN} from the DNS provider (check credentials, zone id, network)"
  count=$(jq 'length' <<<"$RECORDS")

  if (( count > 1 )); then
    alert "multi-a" high "CasaVPN: multiple A records" \
      "$count A records exist for ${CASAVPN_DOMAIN}; clients would be split across them. Delete the extras in your DNS dashboard. Nothing was changed."
    die "$count A records for ${CASAVPN_DOMAIN}; refusing to guess which one to manage"
  fi

  old_ip=$(jq -r '.[0].content // empty' <<<"$RECORDS")
  rid=$(jq -r '.[0].id // empty' <<<"$RECORDS")

  if [[ "$CHECK" -eq 1 ]]; then
    if [[ "$count" -eq 1 && "$old_ip" == "$PUBLIC_IP" ]] && record_matches "$PUBLIC_IP"; then
      log "OK: ${CASAVPN_DOMAIN} -> ${old_ip} matches the public IP (proxied=false ttl=${DESIRED_TTL})"
      rc=0
    elif [[ "$count" -eq 1 && "$old_ip" == "$PUBLIC_IP" ]]; then
      log "MISMATCH: ${CASAVPN_DOMAIN} has the right IP but drifted settings: $(describe_drift)"
      rc=1
    else
      log "MISMATCH: ${CASAVPN_DOMAIN} -> '${old_ip:-no record}', public IP is ${PUBLIC_IP}"
      rc=1
    fi
    log "note: public-IP echo services cannot detect CGNAT. To prove the VPN is reachable, run from another network (phone on mobile data): nc -vz ${CASAVPN_DOMAIN} ${CASAVPN_VPN_PORT}"
    exit "$rc"
  fi

  if [[ "$count" -eq 1 ]] && record_matches "$PUBLIC_IP"; then
    drift=""
    if [[ "$FORCE" -eq 0 ]]; then
      log "in sync: ${CASAVPN_DOMAIN} -> ${PUBLIC_IP} (proxied=false ttl=${DESIRED_TTL})"
      write_state_if_changed last-ip "$PUBLIC_IP"
      write_state_if_changed fail-count 0
      exit 0
    fi
    log "--force: rewriting an already-correct record"
  elif [[ "$count" -eq 0 ]]; then
    drift="no A record; creating ${PUBLIC_IP}"
  else
    drift=$(describe_drift)
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "DRY RUN: would update ${CASAVPN_DOMAIN}: ${drift:-forced rewrite}"
    exit 0
  fi

  provider_call update "$rid" "$PUBLIC_IP" || die "DNS update failed for ${CASAVPN_DOMAIN} (provider ${CASAVPN_DDNS_PROVIDER})"
  provider_call get || die "update sent but the read-back from the DNS provider failed"
  record_matches "$PUBLIC_IP" \
    || die "read-back disagrees with what was written: $(jq -c '.' <<<"$RECORDS" | head -c 300)"

  write_state last-ip "$PUBLIC_IP" || die "could not write state"
  write_state fail-count 0
  log "updated ${CASAVPN_DOMAIN} (${drift:-forced rewrite}); read-back verified"

  if [[ -n "$drift" ]]; then
    alert "changed-${old_ip:-none}-${PUBLIC_IP}" default "CasaVPN: DNS updated" \
      "${CASAVPN_DOMAIN}: ${old_ip:-none} -> ${PUBLIC_IP} (${drift})"
  fi
  exit 0
}

# Sourced by the tests for the pure functions; executed normally otherwise.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
